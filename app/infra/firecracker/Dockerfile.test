# Self-contained test image for the firecracker track. Deliberately not
# wired into app/docker-compose.yml's shared "test" service: that service
# mounts only world/broker/game/research/supabase/tests
# (app/docker-compose.yml), and this track's task is scoped to
# app/infra/firecracker/ only (STAY IN YOUR LANE) - other tracks are
# editing the shared compose file concurrently, so this track gets its
# own, mirroring the pattern engine/docker-compose.yml already uses for
# its own "test" service rather than reusing a sibling's.
#
# e2fsprogs is not a test dependency of the Python suite - it is here so
# rootfs/build_rootfs.sh's mkfs.ext4 -d step (task: rootfs build) can run
# inside this same image during manual verification, without a second
# image to keep in sync.
FROM python:3.12-slim

WORKDIR /app/infra/firecracker

RUN apt-get update && apt-get install -y --no-install-recommends \
    e2fsprogs \
    && rm -rf /var/lib/apt/lists/*

# Pinned to the same ranges app/pyproject.toml already uses elsewhere in
# this monorepo (fastapi, uvicorn, httpx, pytest, pytest-asyncio) so a
# version drift bug can't hide behind "this track pins differently."
RUN pip install --no-cache-dir \
    "fastapi~=0.115" \
    "uvicorn~=0.34" \
    "httpx~=0.27" \
    "pytest>=8.0" \
    "pytest-asyncio>=0.24"

# pytest-asyncio already pulls pytest_asyncio in as its own import name;
# listed as a comment here (not a second pip line) only so the connection
# between the "pytest-asyncio" package and the "pytest_asyncio.fixture"
# decorator tests/*.py uses is not a mystery to the next reader.

# Source is bind-mounted at run time by docker-compose.yml (live edits,
# no rebuild) - this COPY exists only so `docker build` alone produces a
# runnable standalone image, matching engine/Dockerfile's test stage
# comment for the same reason.
COPY . .

ENV PYTHONPATH=/app/infra/firecracker
ENV PYTHONDONTWRITEBYTECODE=1

CMD ["pytest", "tests/", "-v", "--tb=short"]

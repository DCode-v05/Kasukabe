# kasukabe-litestream.service EnvironmentFile.
# Litestream reads its S3 credentials from the standard AWS env vars /
# instance role - on this host it should use the EC2 instance profile
# (scripts/01-setup-s3-and-iam.sh) and needs no static key/secret here.
#
# litestream.yml (the trace-store track's file, not this track's - see
# RUNBOOK.md section 10) expands ${KASUKABE_SQLITE_PATH},
# ${KASUKABE_S3_BUCKET}, and ${AWS_REGION} from this file at load time.
# world.env.example's KASUKABE_SQLITE_PATH comment says it plainly: world,
# broker, and this file must all agree on the exact same SQLite path.

AWS_REGION=ap-south-1

# Same path as world.env / broker.env's KASUKABE_SQLITE_PATH - all three
# MUST match exactly.
KASUKABE_SQLITE_PATH=/opt/kasukabe/data/kasukabe.db

# The bucket scripts/01-setup-s3-and-iam.sh creates and prints as
# BUCKET_NAME - copy that value here verbatim (RUNBOOK.md section 10).
KASUKABE_S3_BUCKET=REPLACE_ME_bucket_name_from_step_3

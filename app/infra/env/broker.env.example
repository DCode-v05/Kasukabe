# kasukabe-broker.service EnvironmentFile.
# Copy to broker.env (chmod 600, kasukabe:kasukabe) and fill in the
# placeholders. Every field here mirrors a BrokerSettings field in
# broker/config.py - see that file's docstring for what each one does.
#
# INFRA-04: this template could not boot the broker it was written for.
# Four separate reasons, all fixed below and all recorded here because a
# template that is wrong in a way nobody noticed is worse than a missing
# one - an operator follows it, the unit crash-loops, and the cause is
# four files away.
#
#   * MOCK_MODE=false. `BrokerSettings.build_from_env` now REJECTS any
#     value of MOCK_MODE with a ConfigError - "this broker only talks to
#     real Bedrock" - so the unit crash-looped at boot on the first line
#     of its own env file. Removed, not set to something else.
#   * KASUKABE_SQLITE_PATH. Not a variable this broker reads. It reads
#     TRACE_SQLITE_PATH, and defaults it to /data/kasukabe.db, which the
#     unit's `ProtectSystem=strict` + `ReadWritePaths=/opt/kasukabe/data`
#     makes UNWRITABLE - so the trace would fail on the first flush, and
#     Litestream would have been tailing a different file from the one the
#     broker wrote. Now set explicitly, to the path the unit can write.
#   * RPM_PER_MODEL. Not read either. `broker/lanes.py` gives each of the
#     six lanes its own bucket, so the setting is RPM_PER_LANE.
#   * SUPABASE_URL / SUPABASE_SERVICE_KEY, under a standing "BLOCKER, do
#     not silently work around" paragraph about a Postgres trace sink that
#     has since been deleted. The broker writes SQLite. A blocker notice
#     about a component that no longer exists is how an operator concludes
#     the deployment is impossible - and naming the class again here would
#     leave the same string in the same file, so this does not.

AWS_REGION=ap-south-1

WORLD_BASE_URL=http://127.0.0.1:8100
WORLD_HTTP_TIMEOUT_S=10.0

# HMAC secret for verifying "<agent_id>.<hex-hmac>" bearer tokens
# (broker/auth.py). Generate with: openssl rand -hex 32
# Every one of the 250 agent tokens minted by
# scripts/07-mint-agent-tokens.py must be signed with THIS SAME value -
# see that script and RUNBOOK.md section 9.
#
# INFRA-05 makes this REQUIRED for any host reachable off-box: with it
# empty the broker trusts a bearer token's agent_id unsigned, so anything
# that can reach the port can bill any resident's wallet by naming them.
# The unsigned path is now refused for non-loopback peers, which means a
# unit binding 0.0.0.0 without this value serves nobody at all.
AUTH_SHARED_SECRET=REPLACE_ME_openssl_rand_hex_32

TRACE_BATCH_SIZE=20
TRACE_FLUSH_INTERVAL_S=2.0

# Per-LANE, not per-model: broker/lanes.py runs six lanes with a bucket
# each (broker/config.py RPM_PER_LANE).
RPM_PER_LANE=100

# The trace store. Same path world.env / litestream.env use
# (world.env.example: "all three MUST agree on this exact path") and
# inside the unit's ReadWritePaths, so the flush can actually land.
TRACE_SQLITE_PATH=/opt/kasukabe/data/kasukabe.db

# The hard spend ceiling for this process, in dollars. The world's own
# governor stops the run a reserve BELOW this (CORE-25), so the town
# halts cleanly rather than ticking on against a broker that has begun
# refusing every call.
SPEND_CAP_USD=380

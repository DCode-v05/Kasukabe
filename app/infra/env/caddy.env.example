# Loaded into the caddy.service via a systemd drop-in
# (/etc/systemd/system/caddy.service.d/override.conf, written by
# scripts/05-configure-caddy.sh) so Caddyfile's {$VAR} references resolve.
# Copy to caddy.env and fill in - see RUNBOOK.md step 6.
#
# IMPORTANT: systemd's EnvironmentFile parser does NOT do shell expansion
# - a literal "$" in KASUKABE_BASIC_AUTH_HASH (bcrypt hashes always start
# with "$2a$" or "$2b$") is safe to paste here unquoted, exactly as
# `caddy hash-password` printed it. Do not wrap the value in quotes.

KASUKABE_DOMAIN_ROOT=kasukabe.september.wtf
KASUKABE_DOMAIN_CONSOLE=console.kasukabe.september.wtf
KASUKABE_ACME_EMAIL=REPLACE_ME_operator@september.wtf
KASUKABE_BASIC_AUTH_HASH=REPLACE_ME_output_of_caddy_hash-password

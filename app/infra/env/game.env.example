# kasukabe-game.service EnvironmentFile.
# Copy to game.env and fill in. Mirrors game/config.py's GameSettings.

MOCK_MODE=false
WORLD_BASE_URL=http://127.0.0.1:8100
WORLD_WS_URL=ws://127.0.0.1:8100/ws/events
WORLD_HTTP_TIMEOUT_S=10.0
WORLD_WS_RECONNECT_DELAY_S=2.0

GAME_HOST=127.0.0.1
GAME_PORT=8400
GAME_REPLAY_BUFFER_SIZE=200

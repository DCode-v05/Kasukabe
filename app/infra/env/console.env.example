# kasukabe-console.service EnvironmentFile.
# Copy to console.env and fill in. Mirrors game/console/config.py's
# ConsoleSettings.

# Must be a real, high-entropy secret in prod - an unset value falls back
# to a fresh random token PER PROCESS RESTART (config.py's own
# docstring), which would lock the operator out on every systemd
# restart. Generate with: openssl rand -base64 32
# This is the SAME token world's admin API (once it exists - see
# game/console/README.md "Open integration point") must be configured
# with, since world independently re-validates it.
OPERATOR_TOKEN=REPLACE_ME_openssl_rand_base64_32

WORLD_BASE_URL=http://127.0.0.1:8100
WORLD_HTTP_TIMEOUT_S=10.0

CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8300

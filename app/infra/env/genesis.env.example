# kasukabe-genesis.service EnvironmentFile.
# Copy to genesis.env (chmod 600, kasukabe:kasukabe) and fill in.
#
# INFRA-04: there was no unit for a genesis run and therefore no env file
# for one, so the deployment path in infra/ could start five services and
# still have no town. Every variable below is one `world/run_genesis.py`
# actually reads - `GenesisRunnerConfig.from_env` is the list.

# The trace store. The same path broker.env's TRACE_SQLITE_PATH and
# litestream.yml point at - all of them MUST agree, or the broker writes
# one file, the world reads another, and Litestream replicates a third.
TRACE_SQLITE_PATH=/opt/kasukabe/data/kasukabe.db

# The operator console's whole authentication: grant a blessing, unleash
# a disaster, move the population dials. Generate with:
#   openssl rand -hex 24
# INFRA-05: this used to be a literal in a committed launcher. Leaving it
# unset makes run_genesis mint an ephemeral one and log it, which is
# usable but means the console cannot be opened until somebody reads the
# journal - set it here instead.
OPERATOR_TOKEN=REPLACE_ME_openssl_rand_hex_24

# Where each resident's engine keeps its brain.sqlite, session log and
# memory stream. Must be inside the unit's ReadWritePaths.
KASUKABE_HOME_ROOT=/opt/kasukabe/agents

# Checkpoints. A day boundary writes one; so does a clean stop.
KASUKABE_CHECKPOINT_DIR=/opt/kasukabe/data/checkpoints

# The hard ceiling for the run. The runner stops itself a reserve BELOW
# the broker's SPEND_CAP_USD (CORE-25), so leaving this unset and letting
# it derive from the broker's cap is the intended arrangement - set it
# only when you want the two to differ deliberately.
# KASUKABE_BUDGET_CAP_CENTS=38000

# Seconds between ticks. 15 is what the series used; a tick is ten game
# minutes, so a game day is 144 ticks and about 36 minutes of wall clock.
KASUKABE_TICK_INTERVAL_S=15

# Where full LLM payloads are archived (INFRA-08). With this set, the
# broker's PayloadArchiver writes gzipped bodies to S3; without it, to a
# local directory under the trace store. Litestream reads the same bucket
# name from infra/env/litestream.env - both must agree.
#
# Left commented on purpose: an unset bucket is a working local archive,
# and a bucket name typed wrong is an archive that silently goes nowhere.
# KASUKABE_S3_BUCKET=REPLACE_ME_bucket_name_from_scripts_01

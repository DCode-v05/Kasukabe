# ═══════════════════════════════════════════════════════════════
# Engine — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── Citadel (REQUIRED — model gateway) ────────────────────────
# Engine no longer holds provider keys. All inference + embeddings
# flow through citadel. In production these two vars are injected
# automatically by bap-engine when it spawns the engine container.
# Set them by hand only when running engine standalone for tests.
CDT_URL=http://citadel:4000
CDT_KEY=

# ── Engine identity ───────────────────────────────────────────
# This pod's identity, normally set by the orchestrator (bap-engine) at
# provision time. The engine emits it in log records and as the
# X-Engine-Id header on outbound citadel calls, so a trace can be
# followed across the whole stack. Leave empty when running standalone.
# ENGINE_ID=

# ── Model selection (all OPTIONAL overrides) ──────────────────
# HERALD OWNS THE DEFAULTS: every default model id lives in
# src/herald/defaults.py (the launch block). Unset/empty here means "use
# the herald default". Any override - and every default - is validated
# against citadel's synced catalog at boot: an unknown id aborts boot
# when the catalog synced, and is a loud warning when citadel was
# unreachable. Citadel routes by model id; provider is implied.
# LLM_MODEL=
MAX_TOKENS=8192

# Override model for the planner sub-agent (heavy tier)
# PLANNER_MODEL=
# Override model for lightweight tasks (compaction summaries, etc.)
# LIGHT_MODEL=

# Triage/dispatch runs on every single input, so it is priced per input
# for the life of the product. Two models are configured from different
# providers: the alternative is used when the primary is unreachable, so
# one provider's outage cannot stop triage. The default pair (and the
# evals/dispatch_bench.py benchmark that ordered it) lives in the herald
# defaults block. Re-run that benchmark before overriding either value.
# NOTE: empty no longer disables dispatch - empty means herald default.
# DISPATCH_MODEL=
# DISPATCH_MODEL_ALTERNATIVE=

# Model the turn falls back to when the primary model is refused or
# unavailable mid-turn. The herald default is empty = no fallback: the
# error surfaces to the caller instead of being retried on another model.
# FALLBACK_MODEL=

# Cache TTL for the global (cross-user) cacheable system-prompt prefix.
# Anthropic charges 2x base for a 1h cache write vs 1.25x for 5m, so a
# long-lived multi-turn session amortizes the 1h write while a short
# one-off context over-pays. Only "5m" and "1h" are accepted; anything
# else fails validate() at boot.
# GLOBAL_CACHE_TTL=1h

# ── Embeddings ────────────────────────────────────────────────
# Used for: input classification, memory search, knowledge retrieval.
# Citadel exposes embeddings via POST {CDT_URL}/v1/embeddings — no
# provider key needed in the engine. Model + dim defaults live in
# src/herald/defaults.py; overriding the model REQUIRES stating its dim
# (validated at boot).
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# ── Web Search (optional — enables web_search tool) ──────────
# Brave Search: https://brave.com/search/api/ (free tier: 2000 queries/month)
# BRAVE_API_KEY=

# Tavily (fallback): https://tavily.com/ (free tier: 1000 queries/month)
# TAVILY_API_KEY=

# ── Asset Directory (MCP connectors) ──────────────────────────
# Fernet key for encrypting MCP credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AD_ENCRYPTION_KEY=

# September registry — the dormant "septemberai" source tier. Public
# metadata endpoint for September's own first-party hosted MCP servers,
# fetched at read time and never seeded into the DB. Empty disables the
# tier: RegistryClient.list_servers() returns [] with no network call.
# SEPTEMBER_REGISTRY_URL=https://registry.september.wtf

# Client ID Metadata Document (SEP-991) URL — the engine's own hosted
# OAuth client identity. When set AND the discovered authorization server
# advertises client_id_metadata_document_supported, discovery uses this
# URL as the client_id (public client + PKCE) instead of Dynamic Client
# Registration. Empty disables CIMD (DCR / pre-registered paths apply).
# SEPTEMBER_CLIENT_METADATA_URL=https://registry.september.wtf/client-metadata.json

# Retention window (days) for the append-only asset logs (execution_log,
# connection_events). Older rows are swept opportunistically on write and
# by the maintenance loop. 0 disables the sweep entirely (unbounded growth).
# ASSET_LOG_RETENTION_DAYS=30

# ── Storage ───────────────────────────────────────────────────
# The one root the engine owns. Everything it writes lives inside it:
#
#   $SEPTEMBER_HOME/
#     brain.sqlite      the memory database
#     config/           permissions.json, settings.json, hooks.json
#     credentials/      engine key hash, tokens at rest
#     skills/           user-created and learned skills
#     plugins/          hook plugins
#     workspaces/       sandbox execution workspaces  (mount MUST allow exec)
#     sidechains/       sub-agent transcripts
#     results/          overflowed tool output
#     cache/  tmp/  log/
#
# Unset it and the engine uses ~/.september, creating it on first boot.
# Set it and the path MUST already exist and be a directory — a set-but-missing
# root is a bad mount or a typo, and booting anyway would write a user's memory
# somewhere nobody will look for it. Created at mode 0700.
# SEPTEMBER_HOME=/var/lib/september

# Everything below defaults inside SEPTEMBER_HOME. Set one only to override it.
# SQLite database — per-user memory brain. Default: $SEPTEMBER_HOME/brain.sqlite
# SQLITE_DB_PATH=

# Sub-agent transcript directory. Default: $SEPTEMBER_HOME/sidechains
# SIDECHAIN_DIR=

# Platform catalog directory (agents, skills, tools, core_soul)
# Production: /catalog is the docker volume mount (Dockerfile VOLUME /catalog).
CATALOG_DIR=/catalog

# Directory of SQL migration scripts. Empty uses the migrations bundled
# with the package (the repo-root migrations/ dir), which is what
# production runs. Point it elsewhere only to test an alternate set.
# MIGRATIONS_DIR=

# ── Learning Centre ───────────────────────────────────────────
# Hours between automated LC batch runs (processes trajectories → episodes → knowledge)
LC_BATCH_INTERVAL_HOURS=6.0
# Cheap model used for LC batch encoding + consolidation. Default lives in
# src/herald/defaults.py; the provider label in boot records comes from the
# citadel catalog entry (LC_PROVIDER is gone).
# LC_MODEL=

# ── Industry Scoping (optional) ───────────────────────────────
# If set, only load core + this domain from catalog. Empty = load all.
# INDUSTRY=

# ── Sandbox & security ────────────────────────────────────────
# Subprocess env-scrub tier applied before spawning child processes.
# See src/utility_directory/subprocess_env.py for the threat model and
# the per-tier scrub lists. validate() rejects any value outside the
# three below, so this is a hard boot gate — but it is never required to
# be set, since it defaults to "default".
# SUBPROCESS_SCRUB_MODE=default   # off | default | strict

# Comma-separated directory allowlist for file operations. Empty applies
# the built-in default policy; set it to confine file ops to these roots.
# ALLOWED_ROOTS=

# Reap the per-user sandbox session after this much inactivity, discarding
# the ephemeral workspace (durable task state lives elsewhere; a fresh
# sandbox is re-provisioned on next use). Default 12h.
# SANDBOX_IDLE_TTL_S=43200

# ── Channels (live-data plane) & catalog sync ─────────────────
# Minimum poll interval (seconds) for a live channel — protects asset quota.
# CHANNEL_POLL_DEFAULT_S=2.0
# Linger (seconds) after the last stream drops before a channel is GC'd.
# CHANNEL_GRACE_S=30.0
# Cap on concurrently live channels.
# CHANNEL_MAX=256
# Full re-pull cadence (seconds) for the model/price catalog from citadel's
# /v1/models. The catalog is poll-only.
# CATALOG_RESYNC_INTERVAL_S=300

# ── Session activity thresholds (ActivityManager) ─────────────
# Drive the state machine active → idle → away → disconnected.
# ACTIVITY_IDLE_TIMEOUT_S=300         # 5 min  → active→idle
# ACTIVITY_AWAY_TIMEOUT_S=1800        # 30 min → idle→away
# ACTIVITY_DISCONNECT_TIMEOUT_S=3600  # 1 hr   → away→disconnected

# ── Feature gates ─────────────────────────────────────────────
# Sixteen boolean gates, all parsed strictly (only "true"/"false").
# Defaults below match the code; uncomment a line only to flip a gate.
# Each is behaviour-neutral when copied to .env as-is.
#
# When True, AD tools run inside the bwrap sandbox.
# ASSET_DIRECTORY_SANDBOXED=true
# When True, a refused/unavailable turn is retried persistently.
# PERSISTENT_RETRY=false
# When True, bootstrap installs a SIGINT handler that fans interrupts out
# to every active turn executor. Keep False under uvicorn (it owns SIGINT
# for graceful shutdown); enable only in CLI/TUI deployments.
# ENABLE_SIGINT_INTERRUPT=false
# When True, the token-budget continuation loop in agent_loop is active;
# when False it is completely inert.
# TOKEN_BUDGET_ENABLED=false
# Stop / pre-tool / post-tool hook execution points at turn and tool
# boundaries. On by default (zero registered hooks is already a no-op).
# STOP_HOOKS_ENABLED=true
# PRE_TOOL_HOOKS_ENABLED=true
# POST_TOOL_HOOKS_ENABLED=true
# When False, hooks are NOT auto-loaded from settings files (user, project,
# local, plugin); programmatic hooks still work. The older inverted var
# INTELLIGENCE_ENGINE_DISABLE_HOOK_SETTINGS is still honoured too.
# HOOKS_SETTINGS_LOAD_ENABLED=true
# When True, the agent loop catches media-specific API errors, strips the
# offending blocks, and retries on a separate budget.
# MEDIA_ERROR_RECOVERY_ENABLED=false
# When True, base64 images are validated (size, empty buffer) before send.
# MEDIA_PRESEND_VALIDATION_ENABLED=false
# When True, oversized images are resized/compressed (Pillow) before the
# API call instead of being stripped.
# MEDIA_IMAGE_RESIZE_ENABLED=false
# When True, large media on execute requests is chunked into ingestion_chunks
# for tool-based retrieval instead of being injected into context.
# CONTENT_INGESTION_ENABLED=false
# When True, query chains are tracked.
# QUERY_CHAIN_TRACKING_ENABLED=false
# When False, context-overflow errors surface immediately with no recovery.
# REACTIVE_COMPACT_ENABLED=true
# When True, a lightweight CacheHitMonitor fires alerts on low cache ratio
# or prefix instability. Cache stats logging (always on) is unaffected.
# CACHE_HIT_MONITOR_ENABLED=true
# When True, the herald factory builds a deterministic canned LLM instead of
# the citadel-routed Provider. Used only by the SDK conformance suite.
# CONFORMANCE_MODE=false

# ── OAuth connector secrets (consumed by scripts/seed_oauth.py) ──
# After populating these and starting the engine, run:
#     docker compose exec engine python scripts/seed_oauth.py
# The script writes oauth_config rows into server_registry. Connectors
# whose CLIENT_ID/SECRET are blank are skipped — frontend will show them
# as configured=false until the env is filled and the seed re-runs.
#
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# ATTIO_CLIENT_ID=
# ATTIO_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# GOOGLEBIGQUERY_CLIENT_ID=
# GOOGLEBIGQUERY_CLIENT_SECRET=
# NETLIFY_CLIENT_ID=
# NETLIFY_CLIENT_SECRET=
# SQUARE_CLIENT_ID=
# SQUARE_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# BLACKBAUD_CLIENT_ID=
# BLACKBAUD_CLIENT_SECRET=
# CUSTOMERIO_CLIENT_ID=
# CUSTOMERIO_CLIENT_SECRET=
# FIREFLIES_CLIENT_ID=
# FIREFLIES_CLIENT_SECRET=
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# MIRO_CLIENT_ID=
# MIRO_CLIENT_SECRET=

# ── Local development on Mac / Windows hosts ──────────────────
# Production runs on Linux x86_64 with native seccomp support, where
# the sandbox layers (bwrap + seccomp + landlock) all work as
# designed. On a Mac or Windows host running the test container via
# Docker Desktop, the kernel exposed to the container goes through a
# Linux VM (Docker Desktop) and possibly QEMU emulation. Two known
# limitations apply:
#
#   1. seccomp BPF cannot be loaded under QEMU x86_64 emulation —
#      `prctl(PR_SET_SECCOMP)` returns EINVAL. tests/conftest.py
#      probes for this at session start (forks a child, tries to load
#      a noop BPF) and, when the probe fails, monkey-patches the
#      sandbox executor's bwrap-arg builder to drop the seccomp_fd.
#      The sandbox tests then run with bwrap + landlock active,
#      seccomp disabled. Production code in src/sandbox/seccomp.py is
#      NOT modified — its unit tests still exercise the real BPF
#      compiler.
#
#   2. bwrap needs CAP_SYS_ADMIN (or full privileged mode) to create
#      user namespaces inside the container. docker-compose.yml's
#      `test` service sets `privileged: true` for this reason. The
#      production `engine` service stays unprivileged.
#
# Both knobs are local-dev infrastructure only — they live in
# docker-compose.yml and tests/conftest.py, never in src/. There's
# nothing to set in this .env file for them. This block exists to
# explain why those files have the shape they have, so a developer on
# Mac or Windows isn't surprised when the test container behaves
# slightly differently from a Linux x86_64 production host.

# Renderer harness (engine/harness/) — the throwaway single-user verification SPA.
# Serve it locally (e.g. `cd harness && python -m http.server 8800`) and allow its
# origin so the browser can reach /execute + /channel/* cross-origin:
# CORS_ORIGINS=http://localhost:8800,http://127.0.0.1:8800
